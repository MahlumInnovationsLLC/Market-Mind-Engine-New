modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-auth-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-client-react-tests"

[[workflows.workflow]]
name = "api-auth-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-client-react-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-client-react run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3002

[[ports]]
localPort = 18116
externalPort = 5000

[[ports]]
localPort = 22333
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["cairo", "cargo", "freetype", "glibcLocales", "libiconv", "libxcrypt", "ocl-icd", "opencl-headers", "openssl", "pkg-config", "postgresql", "qhull", "rustc", "tcl", "tk"]

[userenv]

[userenv.shared]
OPERATOR_ADMIN_EMAILS = "coltermahlum@gmail.com"
OPERATOR_ALLOWED_EMAILS = "coltermahlum@gmail.com,axiom-e2e-operator@example.com"
OPERATOR_ALERT_EMAILS = "coltermahlum@gmail.com"
REVENUECAT_PROJECT_ID = "projd60814d6"
KALSHI_ENV = "prod"
AXIOM_ORCHESTRATOR_VERTICALS = "sports,crypto,commodities,entertainment"
AXIOM_ALLOW_MISSING_MANIFEST = "1"
AXIOM_READY_FEEDS_TIMEOUT_SECONDS = "300"
AXIOM_TRADING_MODE = "live"
AXIOM_COINAPI_DISABLED = "1"
OPERATOR_AUTO_APPROVE_EMAIL_DOMAINS = "example.com"

[userenv.production]
AXIOM_SKIP_ALEMBIC_AT_STARTUP = "1"
